datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PRESTAMISTA
  COBRADOR
}

enum PlanSaaS {
  BRONCE
  PLATA
  ORO
  PLATINO
  DIAMANTE
}

enum SubscriptionType {
  TRIAL
  ACTIVE
  EXPIRED
}

enum LoanStatus {
  ACTIVE
  PAID
}

enum MetodoPago {
  EFECTIVO
  SINPE
  TRANSFERENCIA
}

enum TipoIdentificacion {
  CEDULA_NACIONAL
  PASAPORTE
  RESIDENCIA_DIMEX
  OTRO
}

enum LiquidacionEstado {
  PENDING
  LIQUIDATED
}

model User {
  id              String            @id @default(uuid())
  nombre          String
  username        String            @unique
  password        String
  email           String?
  telefono        String
  rol             Role              @default(PRESTAMISTA)
  plan            PlanSaaS          @default(BRONCE)
  suspendido      Boolean           @default(false)
  fechaPruebaFin  DateTime?
  paymentDate     DateTime?
  /// Solo aplica cuando rol = COBRADOR — apunta al prestamista dueño
  prestamistaId   String?
  prestamista     User?             @relation("CobradorPrestamista", fields: [prestamistaId], references: [id])
  cobradores      User[]            @relation("CobradorPrestamista")
  createdAt       DateTime          @default(now())
  subscriptions   Subscription[]
  loans           Loan[]
  settings        BusinessSettings?
  payments        Payment[]         @relation("PagosCreados")
  cajaCobrador    CajaCobrador?
  liquidaciones   Liquidacion[]     @relation("LiquidacionesCobrador")
  invites         Invite[]
}

model BusinessSettings {
  id                 String @id @default(uuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  monedaSimbolo      String @default("₡")
  monedaCodigo       String @default("CRC")
  timezone           String @default("America/Costa_Rica")
  nombreNegocio      String @default("CAT-LOAN Credit")
  plantillaWhatsapp  String @default("Hola {cliente}, te escribo para recordarte que tu balance pendiente es de {moneda}{saldo}. Tu cuota programada es de {moneda}{cuota}. Favor de enviar el abono a la brevedad. ¡Gracias!")
  gananciaPorcentaje Int    @default(50)
}

model Subscription {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo       SubscriptionType @default(TRIAL)
  validUntil DateTime
  createdAt  DateTime         @default(now())
}

model Loan {
  id                  String     @id @default(uuid())
  prestamistaId       String
  prestamista         User       @relation(fields: [prestamistaId], references: [id], onDelete: Cascade)
  clienteNombre       String
  clienteTelefono     String
  /// Tipo de identificación del cliente
  tipoIdentificacion  TipoIdentificacion? @default(CEDULA_NACIONAL)
  /// Número de identificación para búsqueda rápida
  numeroIdentificacion String?
  montoOriginal       Decimal
  totalAPagar         Decimal
  cuotaSemanal        Decimal
  diaCobro            Int        // 1 = Lunes, 7 = Domingo
  estado              LoanStatus @default(ACTIVE)
  fechaInicio         DateTime   @default(now())
  payments            Payment[]
}

model Payment {
  id            String     @id @default(uuid())
  loanId        String
  loan          Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  montoAbonado  Decimal
  numeroRecibo  String     @unique
  notas         String?
  metodoPago    MetodoPago @default(EFECTIVO)
  /// ID del cobrador que registró este pago (auditoría)
  creadoPorId   String?
  creadoPor     User?      @relation("PagosCreados", fields: [creadoPorId], references: [id])
  fechaPago     DateTime   @default(now())
}

/// Acumulador de caja en tiempo real por cobrador y método de pago
model CajaCobrador {
  id                  String   @id @default(uuid())
  cobradorId          String   @unique
  cobrador            User     @relation(fields: [cobradorId], references: [id], onDelete: Cascade)
  saldoEfectivo       Decimal  @default(0)
  saldoSinpe          Decimal  @default(0)
  saldoTransferencia  Decimal  @default(0)
  updatedAt           DateTime @updatedAt
}

/// Registro de liquidaciones: el prestamista verifica y cierra la caja del cobrador
model Liquidacion {
  id                  String            @id @default(uuid())
  prestamistaId       String
  cobradorId          String
  cobrador            User              @relation("LiquidacionesCobrador", fields: [cobradorId], references: [id])
  montoEfectivo       Decimal
  montoSinpe          Decimal
  montoTransferencia  Decimal
  montoTotal          Decimal
  estado              LiquidacionEstado @default(PENDING)
  notas               String?
  fecha               DateTime          @default(now())
}

/// Token de invitación de un solo uso para registrar cobradores
model Invite {
  id            String   @id @default(uuid())
  prestamistaId String
  prestamista   User     @relation(fields: [prestamistaId], references: [id], onDelete: Cascade)
  rol           Role     @default(COBRADOR)
  usado         Boolean  @default(false)
  createdAt     DateTime @default(now())
}

/// Registro de actividad global del SaaS para auditoría
model LogActividadSaaS {
  id            String   @id @default(uuid())
  fecha         DateTime @default(now())
  tipoEvento    String
  descripcion   String
  ip            String?
  prestamistaId String?
}

/// Configuracion dinamica de precios y limites por cada PlanSaaS
model SaaSPlanConfig {
  id            String   @id @default(uuid())
  plan          PlanSaaS @unique
  maxClientes   Int
  maxCobradores Int
  precioMensual Decimal
  updatedAt     DateTime @updatedAt
}
