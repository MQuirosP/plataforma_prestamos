datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PRESTAMISTA
}

enum SubscriptionType {
  TRIAL
  ACTIVE
  EXPIRED
}

enum LoanStatus {
  ACTIVE
  PAID
}

model User {
  id            String         @id @default(uuid())
  nombre        String
  email         String         @unique
  telefono      String
  rol           Role           @default(PRESTAMISTA)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  loans         Loan[]
}

model Subscription {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo       SubscriptionType @default(TRIAL)
  validUntil DateTime
  createdAt  DateTime         @default(now())
}

model Loan {
  id              String     @id @default(uuid())
  prestamistaId   String
  prestamista     User       @relation(fields: [prestamistaId], references: [id], onDelete: Cascade)
  clienteNombre   String
  clienteTelefono String
  montoOriginal   Decimal
  totalAPagar     Decimal
  cuotaSemanal    Decimal
  diaCobro        Int        // 1 = Lunes, 7 = Domingo
  estado          LoanStatus @default(ACTIVE)
  fechaInicio     DateTime   @default(now())
  payments        Payment[]
}

model Payment {
  id           String   @id @default(uuid())
  loanId       String
  loan         Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  montoAbonado Decimal
  numeroRecibo String   @unique
  notas        String?
  fechaPago    DateTime @default(now())
}
